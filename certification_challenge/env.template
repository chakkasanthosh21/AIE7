# Student Loan Assistant - Environment Configuration
# Copy this file to .env and update with your actual API keys

# Required: OpenAI API Key (Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Cohere API Key (Get from https://dashboard.cohere.ai/api-keys)
# Used for enhanced document reranking
COHERE_API_KEY=your_cohere_api_key_here

# Optional: Tavily API Key (Get from https://tavily.com/)
# Used for real-time web search to enhance responses with current information
TAVILY_API_KEY=your_tavily_api_key_here

# Streamlit Configuration (Optional - defaults shown)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Application Configuration (Optional)
LOG_LEVEL=INFO
ENVIRONMENT=development 